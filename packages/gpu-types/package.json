{
  "name": "@webgpu-streaming/gpu-types",
  "version": "0.1.0",
  "type": "module",
  "description": "Общие TypeScript-типы и фрагменты WGSL для пакетов @webgpu-streaming",
  "license": "MIT",
  "keywords": ["webgpu", "typescript", "types", "texture-streaming"],
  "repository": {
    "type": "git",
    "url": "https://github.com/webgpu-streaming/webgpu-streaming",
    "directory": "packages/gpu-types"
  },
  "homepage": "https://github.com/webgpu-streaming/webgpu-streaming#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.49",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
