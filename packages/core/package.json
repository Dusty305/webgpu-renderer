{
  "name": "@webgpu-streaming/core",
  "version": "0.1.0",
  "type": "module",
  "description": "WebGPU-рендерер с Custom Element и программным API - потоковая передача мип-уровней с управлением бюджетом",
  "license": "MIT",
  "keywords": ["webgpu", "renderer", "3d", "web-components", "texture-streaming", "mip-streaming"],
  "repository": {
    "type": "git",
    "url": "https://github.com/webgpu-streaming/webgpu-streaming",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/webgpu-streaming/webgpu-streaming#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@webgpu-streaming/gpu-types": "^0.1.0",
    "@webgpu-streaming/texture-streaming": "^0.1.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.49",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
